@using Ogani_master.Modelss
@model TDanhMucSp

@{
    ViewData["Title"] = Model.TenSp;
    Layout = "~/Views/Shared/_LayoutChiTiet.cshtml";

    var danhSachAnh =
        ViewBag.AnhSanPham as IEnumerable<TAnhSp>
        ?? Enumerable.Empty<TAnhSp>();
}

<section class="product-details spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="product__details__pic">
                    <img src="@Url.Content("~/Images/" + Model.AnhDaiDien)"
                         alt="@Model.TenSp"
                         style="width:100%; height:420px; object-fit:contain;" />
                </div>

                <div class="row mt-3">
                    @foreach (var anh in danhSachAnh)
                    {
                        <div class="col-4 mb-3">
                            <a href="@Url.Content("~/Images/" + anh.TenFileAnh)"
                               target="_blank"
                               rel="noopener">
                                <img src="@Url.Content("~/Images/" + anh.TenFileAnh)"
                                     alt="@Model.TenSp"
                                     style="width:100%; height:120px; object-fit:contain;" />
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="product__details__text">
                    <h3>@Model.TenSp</h3>

                    <div class="product__details__price">
                        @(Model.GiaNhoNhat?.ToString("N0")) đ
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.GioiThieuSp)
                            ? "Sản phẩm chưa có mô tả."
                            : Model.GioiThieuSp)
                    </p>

                    <ul>
                        <li>
                            <b>Mã sản phẩm</b>
                            <span>@Model.MaSp</span>
                        </li>
                    </ul>

                    <div class="mt-4">
                        <a asp-controller="Home"
                           asp-action="SanPhamTheoLoai"
                           asp-route-maLoai="@Model.MaLoai"
                           class="primary-btn">
                            Sản phẩm cùng loại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>