@model Ogani_master.Modelss.TUser

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>Purple Admin - Login</title>

    <link rel="stylesheet"
          href="~/LayoutAdmin/assets/vendors/mdi/css/materialdesignicons.min.css" />

    <link rel="stylesheet"
          href="~/LayoutAdmin/assets/vendors/css/vendor.bundle.base.css" />

    <link rel="stylesheet"
          href="~/LayoutAdmin/assets/css/style.css" />

    <link rel="shortcut icon"
          href="~/LayoutAdmin/assets/images/favicon.ico" />
</head>

<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth">
                <div class="row flex-grow">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left p-5">

                            <div class="brand-logo">
                                <img src="~/LayoutAdmin/assets/images/logo.svg"
                                     alt="Purple Admin" />
                            </div>

                            <h4>Hello! let's get started</h4>
                            <h6 class="font-weight-light">
                                Sign in to continue.
                            </h6>

                            @using (Html.BeginForm(
                                "Login",
                                "Access",
                                FormMethod.Post,
                                new { @class = "pt-3" }))
                            {
                                @Html.ValidationSummary(
                                    false,
                                    "",
                                    new { @class = "text-danger" }
                                )

                                <div class="form-group">
                                    @Html.TextBoxFor(
                                        x => x.Username,
                                        new
                                        {
                                            @class = "form-control form-control-lg",
                                            placeholder = "Username",
                                            autocomplete = "username",
                                            required = "required"
                                        }
                                    )
                                </div>

                                <div class="form-group">
                                    @Html.PasswordFor(
                                        x => x.Password,
                                        new
                                        {
                                            @class = "form-control form-control-lg",
                                            placeholder = "Password",
                                            autocomplete = "current-password",
                                            required = "required"
                                        }
                                    )
                                </div>

                                <div class="mt-3">
                                    <button type="submit"
                                            class="btn btn-block btn-gradient-primary btn-lg font-weight-medium auth-form-btn w-100">
                                        SIGN IN
                                    </button>
                                </div>

                                <div class="my-2 d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <label class="form-check-label text-muted">
                                            <input type="checkbox"
                                                   class="form-check-input" />
                                            Keep me signed in
                                        </label>
                                    </div>

                                    <a href="#"
                                       class="auth-link text-black"
                                       onclick="return false;">
                                        Forgot password?
                                    </a>
                                </div>

                                <div class="mb-2">
                                    <button type="button"
                                            class="btn btn-block btn-facebook auth-form-btn w-100">
                                        <i class="mdi mdi-facebook me-2"></i>
                                        Connect using facebook
                                    </button>
                                </div>

                                <div class="text-center mt-4 font-weight-light">
                                    Don't have an account?
                                    <a href="#"
                                       class="text-primary"
                                       onclick="return false;">
                                        Create
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/LayoutAdmin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/LayoutAdmin/assets/js/off-canvas.js"></script>
    <script src="~/LayoutAdmin/assets/js/hoverable-collapse.js"></script>
    <script src="~/LayoutAdmin/assets/js/misc.js"></script>
</body>
</html>