@model List<Ogani_master.Modelss.TDanhMucSp>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    int currentPage = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    int totalItems = (int)ViewBag.TotalItems;
    int pageSize = (int)ViewBag.PageSize;

    int stt = (currentPage - 1) * pageSize;
}

<div class="page-header">
    <h3 class="page-title">Danh mục sản phẩm</h3>
</div>

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Danh sách sản phẩm</h4>
                <p>Tổng số: @totalItems sản phẩm</p>
                @if (TempData["ThongBao"] is string thongBao)
                {
                    <div class="alert alert-success">
                        @thongBao
                    </div>
                }

                @if (TempData["Loi"] is string loi)
                {
                    <div class="alert alert-danger">
                        @loi
                    </div>
                }

                <a asp-area="Admin"
                   asp-controller="HomeAdmin"
                   asp-action="ThemSanPhamMoi"
                   class="btn btn-gradient-primary mb-3">
                    + Thêm sản phẩm
                </a>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã sản phẩm</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Mã loại</th>
                                <th>Giá nhỏ nhất</th>
                                <th>Giá lớn nhất</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center">
                                        Chưa có sản phẩm.
                                    </td>
                                </tr>
                            }

                            @foreach (var item in Model)
                            {
                                stt++;

                                <tr>
                                    <td>@stt</td>
                                    <td>@item.MaSp</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.AnhDaiDien))
                                        {
                                            <img src="@Url.Content("~/Images/" + item.AnhDaiDien)"
                                                 alt="@item.TenSp"
                                                 style="width:70px;height:70px;object-fit:contain;border-radius:0;" />
                                        }
                                        else
                                        {
                                            <span>Chưa có ảnh</span>
                                        }
                                    </td>
                                    <td style="white-space:normal;min-width:180px;">
                                        @item.TenSp
                                    </td>
                                    <td>@item.MaLoai</td>
                                    <td>
                                        @(item.GiaNhoNhat?.ToString("N0") ?? "—")
                                    </td>
                                    <td>
                                        @(item.GiaLonNhat?.ToString("N0") ?? "—")
                                    </td>
                                    <td>
                                        <a asp-area=""
                                           asp-controller="Home"
                                           asp-action="ChiTietSanPham"
                                           asp-route-maSp="@item.MaSp"
                                           class="btn btn-gradient-info btn-sm">
                                            Xem
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="HomeAdmin"
                                           asp-action="SuaSanPham"
                                           asp-route-maSp="@item.MaSp"
                                           class="btn btn-gradient-warning btn-sm">
                                            Sửa
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="HomeAdmin"
                                              asp-action="XoaSanPham"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">

                                            <input type="hidden"
                                                   name="maSp"
                                                   value="@item.MaSp" />

                                            <button type="submit"
                                                    class="btn btn-gradient-danger btn-sm">
                                                Xóa
                                            </button>
                                        </form> 
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-4" aria-label="Phân trang sản phẩm">
                        <ul class="pagination flex-wrap">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="HomeAdmin"
                                       asp-action="DanhMucSanPham"
                                       asp-route-page="@i">
                                        @i
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>