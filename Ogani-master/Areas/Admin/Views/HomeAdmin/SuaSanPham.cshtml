@model Ogani_master.ViewModels.ThemSanPhamViewModel

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row">
    <div class="col-lg-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Chỉnh sửa sản phẩm</h4>

                <form asp-area="Admin"
                      asp-controller="HomeAdmin"
                      asp-action="SuaSanPham"
                      method="post">

                    <div asp-validation-summary="All"
                         class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="MaSp">Mã sản phẩm</label>
                        <input asp-for="MaSp"
                               class="form-control"
                               maxlength="25"
                               readonl />
                        <span asp-validation-for="MaSp"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TenSp">Tên sản phẩm</label>
                        <input asp-for="TenSp"
                               class="form-control"
                               maxlength="150" />
                        <span asp-validation-for="TenSp"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MaLoai">Loại sản phẩm</label>
                        <select asp-for="MaLoai"
                                asp-items="ViewBag.DanhSachLoai"
                                class="form-control">
                            <option value="">-- Chọn loại sản phẩm --</option>
                        </select>
                        <span asp-validation-for="MaLoai"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="GiaNhoNhat">Giá nhỏ nhất (đồng)</label>
                        <input asp-for="GiaNhoNhat"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control" />
                        <span asp-validation-for="GiaNhoNhat"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="GiaLonNhat">Giá lớn nhất (đồng)</label>
                        <input asp-for="GiaLonNhat"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control" />
                        <span asp-validation-for="GiaLonNhat"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AnhDaiDien">Tên file ảnh</label>
                        <input asp-for="AnhDaiDien"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ví dụ: balo-moi.jpg" />
                        <small class="text-muted">
                            Nhập tên file đã có trong wwwroot/Images,
                            bao gồm đuôi .jpg hoặc .png.
                        </small>
                        <span asp-validation-for="AnhDaiDien"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="GioiThieuSp">Giới thiệu sản phẩm</label>
                        <textarea asp-for="GioiThieuSp"
                                  class="form-control"
                                  rows="4"
                                  maxlength="255"></textarea>
                        <span asp-validation-for="GioiThieuSp"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-gradient-primary me-2">
                        Lưu thay đổi
                    </button>

                    <a asp-area="Admin"
                       asp-controller="HomeAdmin"
                       asp-action="DanhMucSanPham"
                       class="btn btn-light">
                        Quay lại
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>